# A pagina de entrada nunca pode vir do cache do navegador: em 10/09/2026 um navegador
# ficou servindo o main.js do dia anterior mesmo depois de fechar e abrir, e a equipe
# passou a manha com o estoque "voltando" enquanto a correcao ja estava no ar.
# Os assets levam ?v= no nome, entao so o index precisa disto.
/
  Cache-Control: no-store
/index.html
  Cache-Control: no-store

# App Vi Atendimento (16/11/2026): a página e o service worker nunca vêm do cache, senão o
# celular continua com a versão velha do app depois de publicar.
/whatsapp
  Cache-Control: no-store
/whatsapp.html
  Cache-Control: no-store
/sw-atendimento.js
  Cache-Control: no-cache
/atendimento.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache
